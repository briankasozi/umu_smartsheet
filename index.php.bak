<script>
const filterInput = document.getElementById('filterInput');
const statusFilter = document.getElementById('statusFilter');
const projectSwitcher = document.getElementById('projectSwitcher');
if (projectSwitcher) {
    projectSwitcher.addEventListener('change', () => {
        const id = projectSwitcher.value;
        const url = new URL(window.location.href);
        url.searchParams.set('project_id', id);
        window.location.href = url.toString();
    });
}
function applyFilters(){
    const q = (filterInput?.value || '').trim().toLowerCase();
    const st = statusFilter?.value || '';
    const rows = Array.from(document.querySelectorAll('#sheetBody tr'));
    rows.forEach(row => {
        const t = row.querySelector('[data-col="task"]').textContent.toLowerCase();
        const s = row.querySelector('[data-col="status"]').textContent.trim();
        const a = row.querySelector('[data-col="assignees"]').textContent.toLowerCase();
        const qMatch = !q || t.includes(q) || s.toLowerCase().includes(q) || a.includes(q);
        const sMatch = !st || s === st;
        row.style.display = (qMatch && sMatch) ? '' : 'none';
    });
}
if (filterInput) filterInput.addEventListener('input', applyFilters);
if (statusFilter) statusFilter.addEventListener('change', applyFilters);
applyFilters();
</script>
