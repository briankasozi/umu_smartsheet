<?php
// index.php - Modern Smartsheet-style Dashboard
require_once 'config/db.php';
require_once 'models/Task.php';
require_once 'models/User.php';

// Load all projects for switcher
$allProjectsStmt = $pdo->query('SELECT * FROM projects ORDER BY created_at DESC');
$allProjects = $allProjectsStmt->fetchAll();

// Determine active project: explicit ?project_id=.. or fallback to latest
$requestedId = isset($_GET['project_id']) ? (int)$_GET['project_id'] : null;
if ($requestedId) {
    $stmt = $pdo->prepare('SELECT * FROM projects WHERE id = ?');
    $stmt->execute([$requestedId]);
    $project = $stmt->fetch();
}
if (empty($project)) {
    $stmt = $pdo->query('SELECT * FROM projects ORDER BY created_at DESC LIMIT 1');
    $project = $stmt->fetch();
}
$project_id = $project ? (int)$project['id'] : null;

// Prepare tasks for the active project
$tasks = [];
if ($project_id) {
    $tasks = getTasksByProject($project_id);
}

function colorForStatus($status) {
    if ($status === 'Completed') return ['bg' => 'bg-green-100', 'text' => 'text-green-800', 'dot' => 'bg-green-500'];
    if ($status === 'In Progress') return ['bg' => 'bg-yellow-100', 'text' => 'text-yellow-800', 'dot' => 'bg-yellow-400'];
    if ($status === 'Pending' || $status === 'Blocked') return ['bg' => 'bg-red-100', 'text' => 'text-red-800', 'dot' => 'bg-red-500'];
    return ['bg' => 'bg-gray-100', 'text' => 'text-gray-800', 'dot' => 'bg-gray-400'];
}
