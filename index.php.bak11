if (!isset($_SESSION['user_id'])) {
    header('Location: login.php');
    exit;
}

$pdo = getConnection();
$allProjects = Project::getAllProjects($pdo);
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - TagDev2.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="public/style.css">
</head>
<body class="bg-gray-50">
    <?php include 'views/sidebar.php'; ?>

    <!-- Main Content -->
    <div id="mainContent" class="pl-[31rem] pr-4 pt-4">
        <div class="max-w-7xl mx-auto">
            <h1 class="text-2xl font-semibold text-gray-900 mb-6">Welcome to TagDev2.0 Project Management</h1>
            <?php if (!empty($allProjects)): ?>
                <div class="bg-white shadow-sm rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">End Date</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <?php foreach ($allProjects as $project): ?>
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><?= htmlspecialchars($project['name']) ?></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><?= htmlspecialchars($project['description']) ?></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><?= htmlspecialchars($project['start_date']) ?></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><?= htmlspecialchars($project['end_date']) ?></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><?= htmlspecialchars($project['status']) ?></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <a href="controllers/project_sheet.php?id=<?= $project['id'] ?>" class="text-indigo-600 hover:text-indigo-900">View</a>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php else: ?>
                <p class="text-gray-500">No projects found. Create a new project to get started.</p>
            <?php endif; ?>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const menuButton = document.querySelector('[data-collapse-toggle="navbar-sidebar"]');
            const sidebar = document.getElementById('navbar-sidebar');
            const mainContent = document.getElementById('mainContent');
            
            menuButton.addEventListener('click', function() {
                const isCollapsed = sidebar.classList.contains('hidden');
                
                if (isCollapsed) {
                    sidebar.classList.remove('hidden');
                    mainContent.classList.remove('pl-20');
                    mainContent.classList.add('pl-[31rem]');
                } else {
                    sidebar.classList.add('hidden');
                    mainContent.classList.remove('pl-[31rem]');
                    mainContent.classList.add('pl-20');
                }
            });
        });
    </script>
</body>
</html>