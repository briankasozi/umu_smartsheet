            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="w-16">#</th>
                            <th>Task</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Condition</th>
                            <th>Start Date</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                    <?php $current_date = strtotime(date('Y-m-d')); ?>
                    <?php foreach ($tasks as $index => $task): 
                        $status = $task['status'] ?: 'Not Started';
                        $statusClass = match($status) {
                            'Complete' => 'bg-green-100 text-green-800',
                            'In Progress' => 'bg-blue-100 text-blue-800',
                            default => 'bg-gray-100 text-gray-800'
                        };
                        
                        // Determine condition based on dates
                        $due_date = strtotime($task['due_date']);
                        $condition = '';
                        if ($due_date) {
                            $days_left = ($due_date - $current_date) / (60 * 60 * 24);
                            if ($status === 'Complete') {
                                $condition = 'condition-green';
                            } elseif ($days_left < 0) {
                                $condition = 'condition-red';
                            } elseif ($days_left < 7) {
                                $condition = 'condition-yellow';
                            } else {
                                $condition = 'condition-green';
                            }
                        }
                    ?>
                        <tr class="hover:bg-gray-50">
                            <td class="text-gray-500"><?= $index + 1 ?></td>
                            <td>
                                <a href="#" class="text-blue-600 hover:underline"><?= htmlspecialchars($task['title']) ?></a>
                            </td>
                            <td>
                                <span class="status-badge <?= $statusClass ?>"><?= htmlspecialchars($status) ?></span>
                            </td>
                            <td>
                                <?php if (!empty($task['assignees'])): 
                                    foreach ($task['assignees'] as $assignee):
                                        $initials = strtoupper(substr($assignee['username'], 0, 2));
                                        $color = match(crc32($assignee['username']) % 4) {
                                            0 => 'bg-blue-100 text-blue-800',
                                            1 => 'bg-green-100 text-green-800',
                                            2 => 'bg-purple-100 text-purple-800',
                                            3 => 'bg-pink-100 text-pink-800',
                                        };
                                ?>
                                    <div class="flex items-center gap-2">
                                        <div class="avatar <?= $color ?>"><?= $initials ?></div>
                                        <span class="text-gray-700"><?= htmlspecialchars($assignee['username']) ?></span>
                                    </div>
                                <?php 
                                    endforeach;
                                else: ?>
                                    <span class="text-gray-400 italic">Unassigned</span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <span class="condition-dot <?= $condition ?>"></span>
                            </td>
                            <td class="text-gray-500">
                                <?= $task['start_date'] ? date('m/d/y', strtotime($task['start_date'])) : '' ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Project switcher
        const projectSwitcher = document.getElementById('projectSwitcher');
        if (projectSwitcher) {
            projectSwitcher.addEventListener('change', () => {
                window.location.href = `index.php?project_id=${projectSwitcher.value}`;
            });
        }
    });
    </script>
